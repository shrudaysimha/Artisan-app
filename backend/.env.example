# Artisan Camera & Kalaa Setu Environment Variables Example
# Copy this file to backend/.env and insert your real API keys

# Set your Groq API Key here (from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Digital India Bhashini (NLTM / Udhyat)
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Optional Google Gemini Vision Fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Database & Cloudinary Variables
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
